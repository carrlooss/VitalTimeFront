<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="10dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/card_background"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- NOMBRE COMPLETO -->
        <TextView
            android:id="@+id/tvNombrePaciente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre Apellido"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary_800" />

        <!-- EMAIL -->
        <TextView
            android:id="@+id/tvEmailPaciente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="email@paciente.com"
            android:textSize="14sp"
            android:textColor="@color/gray_700"
            android:layout_marginTop="2dp"/>

        <!-- TELEFONO -->
        <TextView
            android:id="@+id/tvTelefonoPaciente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tel: 123 456 789"
            android:textSize="14sp"
            android:textColor="@color/gray_700"
            android:layout_marginTop="2dp"/>

        <!-- FECHA DE NACIMIENTO -->
        <TextView
            android:id="@+id/tvFechaNacimientoPaciente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nacimiento: 12/05/1990"
            android:textSize="14sp"
            android:textColor="@color/gray_700"
            android:layout_marginTop="2dp"/>

        <!-- GÉNERO -->
        <TextView
            android:id="@+id/tvGeneroPaciente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Género: Masculino"
            android:textSize="14sp"
            android:textColor="@color/gray_700"
            android:layout_marginTop="2dp"/>

        <!-- CONTACTO DE EMERGENCIA -->
        <TextView
            android:id="@+id/tvContactoEmergenciaPaciente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergencia: 987 654 321"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/error_red"
            android:layout_marginTop="4dp"/>

        <!-- BOTONES EN FILA -->
        <LinearLayout
            android:id="@+id/layoutBotonesPaciente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp">

            <!-- ELIMINAR -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminarPaciente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eliminar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/error_red"
                app:cornerRadius="16dp"
                android:paddingHorizontal="12dp" />

            <!-- EDITAR -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarPaciente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/card_orange"
                app:cornerRadius="16dp"
                android:paddingHorizontal="12dp"
                android:layout_marginStart="8dp" />

            <!-- VER CITAS -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerCitasPaciente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver citas"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/primary_800"
                app:cornerRadius="16dp"
                android:paddingHorizontal="12dp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>