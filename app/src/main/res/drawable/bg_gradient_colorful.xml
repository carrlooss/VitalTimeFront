<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gradiente de fondo -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#4FC3F7"
            android:centerColor="#81C784"
            android:endColor="#BA68C8"
            android:angle="45"/>
        </shape>
    </item>

    <!-- Overlay suave para darle profundidad -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80FFFFFF"/> <!-- Blanco semitransparente -->
        </shape>
    </item>

</layer-list>